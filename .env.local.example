# Copia este ficheiro para .env.local (desenvolvimento) e define as mesmas variáveis
# na Vercel: Project → Settings → Environment Variables.
# Instruções completas para ligar a Google Drive: docs/orcamentos-google-sheets.md

# URL da aplicação Web do Google Apps Script (termina em /exec).
# Sem este valor, em desenvolvimento os pedidos aparecem só na consola do servidor.
CONTACT_WEBHOOK_URL=

# O mesmo valor da propriedade WEBHOOK_SECRET no Apps Script.
CONTACT_WEBHOOK_SECRET=

# Opcional: email mostrado ao cliente se o envio falhar.
# CONTACT_EMAIL=geral@exemplo.pt

# Opcional: destino dos botões "Entrar".
# NEXT_PUBLIC_APP_URL=https://taxi-rust-psi.vercel.app

# Opcional: URL absoluto do site para as pré-visualizações nas redes sociais.
# Na Vercel usa-se automaticamente o domínio de produção.
# NEXT_PUBLIC_SITE_URL=https://taxiflow-tau.vercel.app
